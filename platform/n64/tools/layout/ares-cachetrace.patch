+auto CPU::missHistCommand(u64 code) -> void {
+  if(code == 8 && !missHist.itrace) {
+    const char* p = getenv("ARES_TRACE");
+    string base = p ? p : "/tmp/ares_trace";
+    missHist.itrace = fopen(string{base, ".i"}, "wb");
+    missHist.dtrace = fopen(string{base, ".d"}, "wb");
+    missHist.ilast = ~0u; missHist.ilen = 0;
+    missHist.wasJit = recompiler.enabled;
+    recompiler.enabled = false;   //interpreter: every fetch goes through icache.fetch
+  }
+  if(code == 9 && missHist.itrace) {
+    missHist.iflush();
+    fclose(missHist.itrace); fclose(missHist.dtrace);
+    missHist.itrace = missHist.dtrace = nullptr;
+    recompiler.enabled = missHist.wasJit;
+  }
+  if(code == 6) {
+    missHist.ipc.assign(1 << 21, 0);
+    missHist.dpc.assign(1 << 21, 0);
+    missHist.dline.assign(1 << 19, 0);
+    missHist.wbline.assign(1 << 19, 0);
+    missHist.on = true;
+  }
+  if(code == 7 && missHist.on) {
+    missHist.on = false;
+    const char* path = getenv("ARES_MISSHIST");
+    FILE* f = fopen(path ? path : "/tmp/ares_misshist.txt", "w");
+    if(!f) return;
+    for(u32 i = 0; i < missHist.ipc.size(); i++)
+      if(missHist.ipc[i]) fprintf(f, "I %08x %u\n", 0x80000000u | (i << 2), missHist.ipc[i]);
+    for(u32 i = 0; i < missHist.dpc.size(); i++)
+      if(missHist.dpc[i]) fprintf(f, "DP %08x %u\n", 0x80000000u | (i << 2), missHist.dpc[i]);
+    for(u32 i = 0; i < missHist.dline.size(); i++)
+      if(missHist.dline[i]) fprintf(f, "DL %08x %u\n", 0x80000000u | (i << 4), missHist.dline[i]);
+    for(u32 i = 0; i < missHist.wbline.size(); i++)
+      if(missHist.wbline[i]) fprintf(f, "WB %08x %u\n", 0x80000000u | (i << 4), missHist.wbline[i]);
+    fclose(f);
+  }
+}
